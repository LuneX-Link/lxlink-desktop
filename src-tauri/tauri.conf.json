{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "LX Link",
  "version": "0.0.1",
  "identifier": "com.lxlink.app",
  "build": {
    "beforeDevCommand": "vite --port 5176",
    "devUrl": "http://localhost:5176",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "",
        "width": 320,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#000000",
        "url": "/splash.html",
        "devtools": false
      },
      {
        "label": "main",
        "title": "",
        "width": 1280,
        "height": 800,
        "minWidth": 990,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": true,
        "backgroundColor": "#000000",
        "url": "/index.html",
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDNjNEOENGMTY3N0JDQUIKUldTcnZIY1d6OWhqakRNU3psbTR2TkcvRG1JaU9zNzZYTlR0KzlZUlVteU4wOXRBMldHcGkxRSsK",
      "endpoints": [
        "http://localhost:8000/storage/v1/object/public/lxlink-updates/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
